{
  "name": "trainview-sp",
  "private": true,
  "version": "1.0.0",
  "description": "Mapa 3D da rede sobre trilhos de São Paulo com posição ESTIMADA dos trens a partir da tabela oficial de intervalos (GTFS SPTrans).",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "map:fetch": "node scripts/fetch-map.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "vite": "^8.3.4"
  }
}
